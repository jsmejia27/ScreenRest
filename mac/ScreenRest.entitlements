<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Used only when signing with a Developer ID (hardened runtime). ScreenRest is not sandboxed.
     Calendar access is the one protected resource it reads (optional "Use my calendar" setting).
     Camera and microphone are never opened: it only checks whether another app is using them. -->
<dict>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
